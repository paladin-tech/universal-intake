# Universal Intelligent Intake — environment variables
#
# Copy this file to .env.local and fill in values for local development.
# Never commit .env.local or any file containing real credentials.

# OpenAI API key for schema-bound extraction.
# If absent, the engine falls back to the deterministic extractor automatically.
OPENAI_API_KEY=

# Optional: override the OpenAI model used for extraction.
# Defaults to gpt-4.1-mini if not set.
# OPENAI_MODEL=gpt-4.1-mini
